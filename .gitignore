# Visual Studio
.vs/
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb
.vsconfig

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app
*.ipa

# Debug files
*.pdb
*.exp

# These project files can be generated by the engine
*.xcodeproj
*.xcworkspace
*.sln

# Precompiled Assets
SourceArt/**/*.png
SourceArt/**/*.tga

# Unreal Engine directories (** prefix matches inside any subfolder)
**/Binaries/
**/Intermediate/
**/Saved/
**/DerivedDataCache/
**/Build/

# Whitelist PakBlacklist and icon files in Build
!**/Build/*/
**/Build/*/**
!**/Build/*/PakBlacklist*.txt
!**/Build/**/*.ico

# Built data for maps
*_BuiltData.uasset

# Plugins
**/Plugins/**/Binaries/
**/Plugins/**/Intermediate/
